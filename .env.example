# ============================================
# DATABASE CONFIGURATION
# ============================================
MYSQL_ROOT_PASSWORD=root123
DB_HOST=mysql
DB_PORT=3306
DB_USER=quest_user
DB_PASSWORD=quest_pass
DB_NAME=quest_generator

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=8010
DEBUG~

# ============================================
# QDRANT CONFIGURATION
# ============================================
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=your-secret-key
QDRANT_HTTPS=false

# ============================================
# AI CONFIGURATION
# ============================================
# Mode: hybrid, ollama, xai, openai, gemini
AI_MODE=hybrid

# Ollama (local - requires running locally or via host.docker.internal)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=mistral:latest

# xAI (Grok API)
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-2-latest
XAI_API_KEY=your_xai_api_key_here

# OpenAI
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-1.5-flash
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================
# IMAGE GENERATION (Stable Diffusion)
# ============================================
SD_ENABLED=false
SD_BASE_URL=http://host.docker.internal:7860
SD_T2I_ENDPOINT=/sdapi/v1/txt2img
SD_TIMEOUT=120
SD_STEPS=24
SD_CFG_SCALE=7
SD_WIDTH=768
SD_HEIGHT=512

# ============================================
# WEB IMAGE SEARCH INTEGRATION
# ============================================
# Optional HTTP proxy url (e.g. http://username:password@ip:port) to bypass DuckDuckGo rate limits
IMAGE_SEARCH_PROXY=
# Google Custom Search Engine ID (CX) and API key for fallback image searches
GOOGLE_CSE_CX=your_google_cse_cx_here
GOOGLE_CSE_API_KEY=your_google_cse_api_key_here
# Unsplash Access Key for fallback image searches
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

